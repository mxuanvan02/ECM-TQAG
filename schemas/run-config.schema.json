{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxuanvan02/ECM-TQAG/schemas/run-config.schema.json",
  "title": "ECM-TQAG run config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "packages",
    "output",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "ecm-tqag.run-config.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "offline",
        "openai-compatible"
      ]
    },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "text_only",
          "text_layout",
          "full_pixels"
        ]
      }
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https?://"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "api_key_env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "openai-compatible"
          }
        }
      },
      "then": {
        "required": [
          "endpoint",
          "model",
          "api_key_env"
        ]
      }
    }
  ]
}
