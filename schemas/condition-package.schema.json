{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxuanvan02/ECM-TQAG/schemas/condition-package.schema.json",
  "title": "ECM-TQAG condition package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item_id",
    "question",
    "condition",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "ecm-tqag.condition-package.v1"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "condition": {
      "enum": [
        "text_only",
        "text_layout",
        "full_pixels"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "pixel_asset": {
      "$ref": "#/$defs/pixel"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "condition": {
            "const": "text_only"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "not": {
              "required": [
                "layout"
              ]
            }
          }
        },
        "not": {
          "required": [
            "pixel_asset"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "text_layout"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "required": [
              "layout"
            ]
          }
        },
        "not": {
          "required": [
            "pixel_asset"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "full_pixels"
          }
        }
      },
      "then": {
        "required": [
          "pixel_asset"
        ],
        "properties": {
          "evidence": {
            "required": [
              "layout"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "pixel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "media_type",
        "data",
        "byte_length",
        "sha256",
        "dimensions",
        "provenance"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "media_type": {
          "const": "image/png"
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
