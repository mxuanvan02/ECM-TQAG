{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ecm-tqag.generation-manifest.v1","title":"Generation manifest v1","type":"object","additionalProperties":false,"required":["schema","source","items","receipt"],
  "properties":{"schema":{"const":"ecm-tqag.generation-manifest.v1"},"source":{"type":"object","additionalProperties":false,"required":["document_id","sha256"],"properties":{"document_id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/hash"}}},"items":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["item_id","motif_id","tqa_path","tqa_receipt","packages"],"properties":{"item_id":{"$ref":"#/$defs/id"},"motif_id":{"$ref":"#/$defs/id"},"tqa_path":{"$ref":"#/$defs/path"},"tqa_receipt":{"$ref":"#/$defs/hash"},"packages":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["condition","path","sha256"],"properties":{"condition":{"enum":["text_only","text_layout","full_pixels"]},"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/hash"}}}}}}},"receipt":{"$ref":"#/$defs/hash"}},
