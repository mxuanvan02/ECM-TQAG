{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxuanvan02/ECM-TQAG/schemas/run-summary.schema.json",
  "title": "ECM-TQAG run summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "mode",
    "config_sha256",
    "record_count",
    "records",
    "summary_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ecm-tqag.run-summary.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "offline",
        "openai-compatible"
      ]
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "answer.schema.json"
      }
    },
    "summary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
